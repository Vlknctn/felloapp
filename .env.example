# CogniMemo HTTP API
COGNIMEMO_API_URL=https://api.cognimemo.com
COGNIMEMO_API_KEY=
COGNIMEMO_INGEST_PATH=/memory/ingest
COGNIMEMO_SEARCH_PATH=/memory/search

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Demo user (hackathon — single user)
FELLO_USER_ID=demo-ahmet

# Database (SQLite path is relative to prisma/schema.prisma)
DATABASE_URL=file:./dev.db

# Demo / agent
DEMO_MODE=true
AGENT_FALLBACK=true

# Vercel: scraping can hit serverless timeouts — use fallback catalog
MARKET_SCRAPE_ENABLED=false
